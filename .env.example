# WebHands runs offline by default. Leave this file empty and the demos still work.
# The process does not auto-load this file. Export the variables yourself,
# or start commands from a shell that already has them.

# Opt in to the LLM planner. The rules planner is still the default until you
# pass --llm or set this to 1.
# WEBHANDS_LLM=1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Open a visible Chromium window for CLI runs (`webhands run --headed` does the same).
# WEBHANDS_HEADED=1
